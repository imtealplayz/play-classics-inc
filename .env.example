# Discord Developer Portal → OAuth2 → General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match the deployed origin, without a trailing slash
APP_URL=https://your-project.vercel.app
# Generate a long random value (at least 32 characters)
SESSION_SECRET=

# MongoDB Atlas → Connect → Drivers → Node.js
# Use a dedicated database user with readWrite access to play_classics.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
PLAY_CLASSICS_DB_NAME=play_classics
